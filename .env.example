TG2WEB_BIND_ADDR=127.0.0.1:8787
TG2WEB_DATABASE_PATH=data/tg2web.sqlite3
TG2WEB_MEDIA_CACHE_PATH=data/media-cache
TG2WEB_TDLIB_DATABASE_PATH=data/tdlib

# TDLib is linked by the Rust backend through tdlib-rs/download-tdlib.
# TG2WEB_TDLIB_ENCRYPTION_KEY_REF=env:TG2WEB_TDLIB_ENCRYPTION_KEY

# Use * for permissive local development, or set your Vite origin.
TG2WEB_CORS_ORIGIN=http://localhost:5173

# Configure one of these before first admin login. The bootstrap password is
# hashed into the database on first start; existing hashes are not overwritten.
TG2WEB_BOOTSTRAP_ADMIN_PASSWORD=change-this-local-password
# TG2WEB_ADMIN_PASSWORD_HASH=$argon2id$v=19$...
